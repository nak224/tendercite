TENDERCITE_DATA_DIR=./data
TENDERCITE_MAX_UPLOAD_MB=30
TENDERCITE_API_URL=http://localhost:8000
# Optional LLM configuration (required only for analysis):
TENDERCITE_LLM_BASE_URL=http://localhost:11434/v1
TENDERCITE_LLM_MODEL=
TENDERCITE_LLM_API_KEY=
TENDERCITE_RETRIEVAL_ENABLED=true
TENDERCITE_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Verified with SentenceTransformers and the real synthetic-tender-3 evaluation.
TENDERCITE_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
TENDERCITE_MAX_PDF_PAGES=500
TENDERCITE_MAX_EXTRACTED_CHARS=2000000

# Local synthetic capability snapshot validation/import API: disabled by default.
TENDERCITE_CAPABILITY_SNAPSHOT_API_ENABLED=false

# Local synthetic mapping/approval API only; disabled unless explicitly enabled.
TENDERCITE_CAPABILITY_MAPPING_API_ENABLED=false

# Local private capability reports include individual UUID coverage; separate opt-in.
TENDERCITE_CAPABILITY_REPORT_API_ENABLED=false

# Native manual profile CRUD, local development only; not authentication.
TENDERCITE_PROFILES_API_ENABLED=false

# Native manual opportunity CRUD, local development only; not authentication.
TENDERCITE_OPPORTUNITIES_API_ENABLED=false

# Read-only native profile/opportunity skill-label comparison; local development only.
TENDERCITE_NATIVE_MATCHING_API_ENABLED=false

# Explicit manual acquisition tracking; local development only.
TENDERCITE_PIPELINE_API_ENABLED=false

# Explicit official TED metadata search and local import; no background discovery.
TENDERCITE_DISCOVERY_API_ENABLED=false

# Explicit German procurement daily Open Data catalogs and local search; separate opt-in.
TENDERCITE_BKMS_DISCOVERY_API_ENABLED=false
